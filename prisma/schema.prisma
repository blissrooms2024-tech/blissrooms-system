// Bliss Rooms System — Prisma schema
// Ported 1:1 from the original Google Sheets column structure (see Config.gs HEADERS).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  BOSS
  ADMIN
  AGENT
  TENANT
  WORKER
}

enum UserStatus {
  ACTIVE
  DISABLED
  /// Self-registered Agent account awaiting Admin approval — can't log in until Admin flips
  /// this to ACTIVE.
  PENDING
}

enum RoomStatus {
  VACANT
  OCCUPIED
  RESERVED
  MAINTENANCE
  /// Used as storage/junk space, not available for rent — excluded from occupancy stats.
  STORE
}

enum ContractStatus {
  DRAFT
  PENDING_APPROVE
  PENDING_SIGN
  ACTIVE
  EXPIRING
  EXPIRED
  TERMINATED
  MOVED_OUT
}

enum PaymentType {
  DEPOSIT
  UTILITIES
  RENTAL
  ADMIN_FEE
  ACCESS_CARD
  CARPARK
  AC
  DRYER
  ELECTRIC
  LATE_FEE
  OTHER
}

enum MoveType {
  MOVE_IN
  MOVE_OUT
}

enum MaintenanceStatus {
  SUBMITTED
  ACKNOWLEDGED
  IN_PROGRESS
  /// Worker uploaded after-photos and submitted for Admin to check + close out with a cost.
  PENDING_REVIEW
  COMPLETED
  CANCELLED
}

enum MaintenanceWorkerType {
  IN_HOUSE
  OUTSOURCED
}

model Counter {
  prefix String @id
  seq    Int    @default(0)
}

model User {
  id           String     @id @default(cuid())
  userCode     String     @unique
  name         String
  email        String     @unique
  passwordHash String
  role         Role
  phone        String?
  ic           String?
  commRate     Decimal?   @db.Decimal(6, 4)
  /// Bank details for paying out commissions (agents) or wages (in-house workers).
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  status       UserStatus @default(ACTIVE)
  verified     Boolean    @default(false)
  verifyToken  String?
  resetToken   String?
  resetExpiry  DateTime?
  createdAt    DateTime   @default(now())

  contractsAsTenant Contract[]        @relation("ContractTenant")
  contractsAsAgent  Contract[]        @relation("ContractAgent")
  currentRooms      Room[]            @relation("RoomCurrentTenant")
  commissions       Commission[]
  moveInOutForms    MoveInOutForm[]

  @@index([role])
}

model Property {
  id           String   @id @default(cuid())
  propertyCode String   @unique
  name         String
  address      String?
  region       String?
  landlord     String?
  /// % of monthly collections Bliss Rooms keeps as management fee when landlord is set
  /// (e.g. 0.10 = 10%). Irrelevant for units Bliss Rooms owns outright (landlord blank).
  managementFeeRate Decimal? @db.Decimal(6, 4)
  /// Fixed monthly rent Bliss Rooms pays the owner under a master-lease arrangement (Bliss
  /// Rooms rents the whole unit from the owner, then sub-lets rooms) — mutually exclusive
  /// with managementFeeRate; a unit is either managed-for-a-landlord-% or leased-from-owner,
  /// never both.
  ownerRentalAmount Decimal? @db.Decimal(10, 2)
  status       String?  @default("Active")
  notes        String?
  rooms        Room[]

  createdAt DateTime @default(now())
}

model Room {
  id             String     @id @default(cuid())
  roomCode       String     @unique
  propertyId     String?
  property       Property?  @relation(fields: [propertyId], references: [id])
  propertyName   String
  roomType       String?
  roomRental     Decimal    @db.Decimal(10, 2)
  carparkRental  Decimal    @default(0) @db.Decimal(10, 2)
  /// The physical parking bay number/label (e.g. "B-123") as painted in the building —
  /// distinct from roomCode, which is this system's own internal code.
  carparkLotNumber String?
  hasAircon      Boolean    @default(false)
  /// True for a standalone carpark slot (not a livable room) — lets a tenant rent just a
  /// parking spot on its own contract, reusing the same Room/Contract machinery.
  isCarpark      Boolean    @default(false)
  status         RoomStatus @default(VACANT)
  currentTenantId String?
  currentTenant   User?      @relation("RoomCurrentTenant", fields: [currentTenantId], references: [id])
  currentContractId String?
  notes          String?
  /// Google Drive folder/album link with room photos, so Agents can view them without a native upload.
  photoLink      String?

  contracts        Contract[] @relation("ContractMainRoom")
  carparkContracts Contract[] @relation("ContractCarparkRoom")

  createdAt DateTime @default(now())

  @@index([status])
}

model Contract {
  id               String         @id @default(cuid())
  contractCode     String         @unique
  roomId           String
  room             Room           @relation("ContractMainRoom", fields: [roomId], references: [id])
  propertyAddress  String?

  /// Optional separate carpark slot linked to this contract (e.g. a living-room tenant who
  /// also rents/gets a parking bay) — distinct from roomId, which can itself be a carpark-only
  /// contract (isCarpark room rented on its own). Keeps that carpark Room's status/currentTenantId
  /// in sync the same way roomId does, so the carpark shows as occupied, not just a fee line.
  carparkRoomId String?
  carparkRoom   Room?   @relation("ContractCarparkRoom", fields: [carparkRoomId], references: [id])

  tenantId   String?
  tenant     User?   @relation("ContractTenant", fields: [tenantId], references: [id])
  tenantName String
  tenantIc   String?

  agentId   String
  agent     User    @relation("ContractAgent", fields: [agentId], references: [id])
  agentName String

  moveInDate        DateTime?
  commencementDate   DateTime?
  expiredDate        DateTime?
  tenureMonths        Int?

  roomRental        Decimal @db.Decimal(10, 2)
  carparkRental     Decimal @default(0) @db.Decimal(10, 2)
  securityDeposit   Decimal @default(0) @db.Decimal(10, 2)
  utilitiesDeposit  Decimal @default(0) @db.Decimal(10, 2)
  earnestDeposit    Decimal @default(0) @db.Decimal(10, 2)
  accessCardDeposit Decimal @default(0) @db.Decimal(10, 2)
  adminFee          Decimal @default(0) @db.Decimal(10, 2)
  totalOutstanding  Decimal @default(0) @db.Decimal(10, 2)

  status ContractStatus @default(DRAFT)

  agentSignature  String?
  agentSignDate   DateTime?
  tenantSignature String?
  tenantSignDate  DateTime?

  commAmount Decimal? @db.Decimal(10, 2)
  commStatus String?  @default("Pending")

  createdBy   String
  createdAt   DateTime  @default(now())
  approvedBy  String?
  approvedAt  DateTime?
  autoDeleteAt DateTime?
  pdfLink     String?
  remarks     String?

  nationality   String?
  contactNumber String?
  email         String?
  occupation    String?
  company       String?
  carPlate      String?

  emergencyName         String?
  emergencyContact      String?
  emergencyRelationship String?

  utilDryer    Boolean @default(false)
  utilAircond  Boolean @default(false)
  utilElectric Boolean @default(false)

  icFront String?
  icBack  String?

  payments            Payment[]
  commissions         Commission[]
  moveForms           MoveInOutForm[]
  maintenanceRequests MaintenanceRequest[]
  warningLetters      WarningLetter[]

  @@index([status])
  @@index([agentId])
  @@index([tenantId])
  @@index([roomId])
}

model Payment {
  id          String      @id @default(cuid())
  paymentCode String      @unique
  contractId  String
  contract    Contract    @relation(fields: [contractId], references: [id])
  roomCode    String
  tenantId    String?
  tenantName  String?
  periodMonth String?
  type        PaymentType
  amountDue   Decimal     @default(0) @db.Decimal(10, 2)
  amountPaid  Decimal     @default(0) @db.Decimal(10, 2)
  dueDate     DateTime?
  paidDate    DateTime?
  status      String      @default("Paid")
  method      String?
  receiptLink String?
  recordedBy  String
  notes       String?
  /// When type=OTHER: Admin's own name for this charge (e.g. "清洁费", "锁匙费") — lets Admin
  /// create ad-hoc bill types on the fly instead of needing a new PaymentType added by a dev.
  customLabel String?

  /// Tenant-upload-then-Admin-approve flow (RENTAL/UTILITIES/AC/DRYER bills): status also takes
  /// "PENDING" (bill issued, awaiting slip), "PENDING_REVIEW" (slip uploaded, awaiting Admin),
  /// "REJECTED" (Admin rejected, tenant must re-upload) alongside the original "Paid".
  reviewedBy       String?
  reviewedAt       DateTime?
  reviewNote       String?
  /// For LATE_FEE rows auto-generated by the cron job: id of the overdue bill this penalty is for.
  relatedPaymentId String?

  @@index([contractId])
}

model Commission {
  id         String   @id @default(cuid())
  commCode   String   @unique
  agentId    String
  agent      User     @relation(fields: [agentId], references: [id])
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id])
  roomCode   String
  saleAmount Decimal  @db.Decimal(10, 2)
  commRate   Decimal  @db.Decimal(6, 4)
  commAmount Decimal  @db.Decimal(10, 2)
  status     String   @default("Pending")
  approvedBy String?
  paidDate   DateTime?
  notes      String?

  @@index([agentId])
  @@index([contractId])
}

model MoveInOutForm {
  id          String   @id @default(cuid())
  formCode    String   @unique
  type        MoveType
  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id])
  tenantId    String?
  tenant      User?    @relation(fields: [tenantId], references: [id])
  roomCode    String
  moveInDate  DateTime?
  formDate    DateTime?
  photos      Json     @default("{}")
  conditions  Json     @default("{}")
  remarks     Json     @default("{}")
  notes       String?
  submittedAt DateTime?
  locked      Boolean   @default(false)

  @@index([contractId, type])
}

model MaintenanceRequest {
  id          String            @id @default(cuid())
  requestCode String            @unique
  contractId  String
  contract    Contract          @relation(fields: [contractId], references: [id])
  roomCode    String
  tenantId    String?
  tenantName  String?
  title       String
  description String?
  photos      Json              @default("[]")
  status      MaintenanceStatus @default(SUBMITTED)
  assignedTo  String?
  adminNote   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  resolvedAt  DateTime?

  /// In-house staff (WORKER role account) upload their own before/after photos here; for
  /// outsourced contractors there's no login, Admin just uploads the invoice/receipt instead.
  workerType         MaintenanceWorkerType?
  assignedWorkerId   String?
  workerBeforePhotos Json                   @default("[]")
  workerAfterPhotos  Json                   @default("[]")
  invoiceUrl         String?
  cost               Decimal?               @db.Decimal(10, 2)
  costPaidAt         DateTime?

  @@index([contractId])
  @@index([status])
  @@index([assignedWorkerId])
}

model WarningLetter {
  id          String   @id @default(cuid())
  letterCode  String   @unique
  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id])
  message     String
  sentBy      String
  triggeredBy String
  createdAt   DateTime @default(now())

  @@index([contractId])
}

model Log {
  id          String   @id @default(cuid())
  logCode     String   @unique
  timestamp   DateTime @default(now())
  type        String
  toEmail     String?
  subject     String?
  status      String?
  relatedId   String?
  triggeredBy String?
}
