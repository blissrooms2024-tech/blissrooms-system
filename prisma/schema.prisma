// Bliss Rooms System — Prisma schema
// Ported 1:1 from the original Google Sheets column structure (see Config.gs HEADERS).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  BOSS
  ADMIN
  AGENT
  TENANT
  WORKER
}

enum UserStatus {
  ACTIVE
  DISABLED
  /// Self-registered Agent account awaiting Admin approval — can't log in until Admin flips
  /// this to ACTIVE.
  PENDING
}

enum RoomStatus {
  VACANT
  OCCUPIED
  RESERVED
  MAINTENANCE
  /// Used as storage/junk space, not available for rent — excluded from occupancy stats.
  STORE
}

enum ContractStatus {
  DRAFT
  PENDING_APPROVE
  PENDING_SIGN
  ACTIVE
  EXPIRING
  EXPIRED
  TERMINATED
  MOVED_OUT
  /// This contract's term ended because the tenant renewed into a fresh contract (see
  /// renewedFromContractId on the new one) — distinct from MOVED_OUT (tenant left) or
  /// TERMINATED (ended for cause).
  RENEWED
}

enum PaymentType {
  DEPOSIT
  UTILITIES
  RENTAL
  ADMIN_FEE
  ACCESS_CARD
  CARPARK
  AC
  DRYER
  ELECTRIC
  LATE_FEE
  OTHER
  /// A ledger entry for a contract's prepaid credit balance — never created by hand, only by
  /// lump-sum overpayment (positive: money banked as credit), a later bill auto-settled from
  /// that credit (negative: credit drawn down), or an Admin correction (either sign). There is
  /// no separate "credit balance" field anywhere — the balance is always just the live sum of
  /// this type's amountPaid for a contract, so it can never drift out of sync with its own
  /// ledger (editing or deleting one of these rows, the same way any other Payment row can be
  /// corrected, is itself what changes the balance — there's nothing else to keep in sync).
  CREDIT
}

enum MoveType {
  MOVE_IN
  MOVE_OUT
}

enum MaintenanceStatus {
  SUBMITTED
  ACKNOWLEDGED
  IN_PROGRESS
  /// Worker uploaded after-photos and submitted for Admin to check + close out with a cost.
  PENDING_REVIEW
  COMPLETED
  CANCELLED
}

enum MaintenanceWorkerType {
  IN_HOUSE
  OUTSOURCED
}

enum ExpenseCategory {
  WATER
  ELECTRIC
  WIFI
  CLEANING
  MAINTENANCE
  /// Household/repair supplies bought for a unit — light bulbs, cleaning products, tools.
  SUPPLIES
  /// Furniture and appliances bought for a unit (mattress, fridge, washing machine…).
  FURNITURE
  /// Petrol, toll, parking, Grab — usually company overhead rather than one unit.
  TRANSPORT
  /// Listing ads, Facebook boosts, signage.
  ADVERTISING
  /// Stationery, printing, phone bills and other office running costs.
  OFFICE
  OTHER
  /// The company's own cost of a voucher given to a tenant (reward/goodwill/compensation) —
  /// only ever created alongside the matching CREDIT Payment row the voucher itself produces
  /// (see Contract voucher-issuing route), never picked by hand from the general expense form.
  VOUCHER
  /// Agent referral commission actually paid out — only ever created by the dedicated
  /// /agent-commissions payout action (see Contract.commAmount/commStatus), never picked by
  /// hand from the general expense form.
  COMMISSION
}

/// Lifecycle of a staff expense claim: submitted → approved (booked as an Expense) or rejected →
/// paid back to the staff member (transfer date recorded for audit).
enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

model Counter {
  prefix String @id
  seq    Int    @default(0)
}

model User {
  id           String     @id @default(cuid())
  userCode     String     @unique
  name         String
  email        String     @unique
  passwordHash String
  role         Role
  phone        String?
  ic           String?
  commRate     Decimal?   @db.Decimal(6, 4)
  /// Bank details for paying out commissions (agents) or wages (in-house workers).
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  status       UserStatus @default(ACTIVE)
  verified     Boolean    @default(false)
  verifyToken  String?
  resetToken   String?
  resetExpiry  DateTime?
  createdAt    DateTime   @default(now())

  contractsAsTenant Contract[]        @relation("ContractTenant")
  contractsAsAgent  Contract[]        @relation("ContractAgent")
  currentRooms      Room[]            @relation("RoomCurrentTenant")
  commissions       Commission[]
  moveInOutForms    MoveInOutForm[]
  expenseClaims     ExpenseClaim[]    @relation("ClaimSubmitter")
  meetingSeats          MeetingAttendee[]
  meetingNotes          MeetingNote[]
  meetingIssuesOwned    MeetingIssue[]    @relation("IssueOwner")
  meetingIssuesFollowed MeetingIssue[]    @relation("IssueFollowUp")

  @@index([role])
}

model Property {
  id           String   @id @default(cuid())
  propertyCode String   @unique
  name         String
  address      String?
  region       String?
  landlord     String?
  /// % of monthly collections Bliss Rooms keeps as management fee when landlord is set
  /// (e.g. 0.10 = 10%). Irrelevant for units Bliss Rooms owns outright (landlord blank).
  managementFeeRate Decimal? @db.Decimal(6, 4)
  /// Fixed monthly rent Bliss Rooms pays the owner under a master-lease arrangement (Bliss
  /// Rooms rents the whole unit from the owner, then sub-lets rooms) — mutually exclusive
  /// with managementFeeRate; a unit is either managed-for-a-landlord-% or leased-from-owner,
  /// never both.
  ownerRentalAmount Decimal? @db.Decimal(10, 2)
  /// Security deposit Bliss Rooms paid the owner under a master-lease arrangement —
  /// refundable to Bliss Rooms when that lease ends. Only meaningful alongside
  /// ownerRentalAmount.
  ownerDeposit Decimal? @db.Decimal(10, 2)
  status       String?  @default("Active")
  notes        String?
  rooms        Room[]
  expenses     Expense[]
  claims       ExpenseClaim[]
  info         PropertyInfo?
  accessCards  AccessCard[]
  utilities    UtilityAccount[]
  utilityMeters UtilityMeter[]
  utilityRuns   UtilityBillRun[]

  createdAt DateTime @default(now())
}

model Room {
  id             String     @id @default(cuid())
  roomCode       String     @unique
  propertyId     String?
  property       Property?  @relation(fields: [propertyId], references: [id])
  propertyName   String
  roomType       String?
  roomRental     Decimal    @db.Decimal(10, 2)
  carparkRental  Decimal    @default(0) @db.Decimal(10, 2)
  /// Standard/asking security deposit for this listing — the amount refundable to whichever
  /// tenant eventually pays it. Shown on the listing as a reference; each Contract still
  /// records its own actual securityDeposit charged at signing.
  securityDeposit Decimal   @default(0) @db.Decimal(10, 2)
  /// The physical parking bay number/label (e.g. "B-123") as painted in the building —
  /// distinct from roomCode, which is this system's own internal code.
  carparkLotNumber String?
  hasAircon      Boolean    @default(false)
  /// True for a standalone carpark slot (not a livable room) — lets a tenant rent just a
  /// parking spot on its own contract, reusing the same Room/Contract machinery.
  isCarpark      Boolean    @default(false)
  status         RoomStatus @default(VACANT)
  currentTenantId String?
  currentTenant   User?      @relation("RoomCurrentTenant", fields: [currentTenantId], references: [id])
  currentContractId String?
  notes          String?
  /// Google Drive folder/album link with room photos — legacy fallback, kept for rooms that
  /// already have one filled in. New uploads use `photos` below instead.
  photoLink      String?
  /// Actual room photos uploaded into the system (Vercel Blob URLs), viewable and downloadable
  /// by anyone who can see this room (Boss/Admin/Agent), not just whoever holds the Drive link.
  photos         String[]   @default([])

  contracts        Contract[] @relation("ContractMainRoom")
  carparkContracts Contract[] @relation("ContractCarparkRoom")
  utilityMeters    UtilityMeter[]
  expenses         Expense[]
  claims           ExpenseClaim[]
  accessCards      AccessCard[]

  createdAt DateTime @default(now())

  @@index([status])
}

model Contract {
  id               String         @id @default(cuid())
  contractCode     String         @unique
  roomId           String
  room             Room           @relation("ContractMainRoom", fields: [roomId], references: [id])
  propertyAddress  String?

  /// Optional separate carpark slot linked to this contract (e.g. a living-room tenant who
  /// also rents/gets a parking bay) — distinct from roomId, which can itself be a carpark-only
  /// contract (isCarpark room rented on its own). Keeps that carpark Room's status/currentTenantId
  /// in sync the same way roomId does, so the carpark shows as occupied, not just a fee line.
  carparkRoomId String?
  carparkRoom   Room?   @relation("ContractCarparkRoom", fields: [carparkRoomId], references: [id])

  tenantId   String?
  tenant     User?   @relation("ContractTenant", fields: [tenantId], references: [id])
  tenantName String
  tenantIc   String?

  agentId   String
  agent     User    @relation("ContractAgent", fields: [agentId], references: [id])
  agentName String

  moveInDate        DateTime?
  commencementDate   DateTime?
  expiredDate        DateTime?
  tenureMonths        Int?
  /// Tenant's declared intent NOT to renew, with the date they expect to move out — set by the
  /// tenant themself near lease expiry (the alternative to contacting Admin about renewal).
  /// Distinct from the actual move-out condition report (MoveInOutForm), which only gets filled
  /// once they're physically checking out — this is just a heads-up so Admin can follow up and
  /// start re-marketing the room ahead of time.
  moveOutNoticeDate DateTime?
  /// Tenant's declared intent TO renew, with how many months they want — the other half of
  /// the "renew or move out" notice, set by the tenant themself. Admin still has to actually
  /// process it (contract reserves Admin's absolute right to decline), on the 续约管理 page.
  renewalRequestedAt     DateTime?
  renewalRequestedMonths Int?
  /// True for a brand-new tenant's first contract only (not legacy imports, not renewals) —
  /// their booking fee (earnestDeposit, same amount as one month's roomRental) already covers
  /// their first full calendar month's rent. The monthly-rent cron checks this: the first
  /// RENTAL bill it would otherwise create PENDING for this contract is instead recorded as
  /// already settled by the booking fee, and this flips back to false so later months bill
  /// normally. Pro-rata rent for the partial move-in period (if any) is a separate up-front
  /// bill and isn't affected by this flag.
  waiveFirstMonthRent Boolean @default(false)
  /// Set on the NEW contract created by the Admin "续约" (renew) flow — points back at the
  /// contractCode of the contract it renews. That old contract gets marked RENEWED once this
  /// one is fully signed (ACTIVE). Not a relation (same convention as Room.currentContractId)
  /// since the two contracts don't need to cascade or be joined in normal queries.
  renewedFromContractId String?

  roomRental        Decimal @db.Decimal(10, 2)
  carparkRental     Decimal @default(0) @db.Decimal(10, 2)
  securityDeposit   Decimal @default(0) @db.Decimal(10, 2)
  utilitiesDeposit  Decimal @default(0) @db.Decimal(10, 2)
  earnestDeposit    Decimal @default(0) @db.Decimal(10, 2)
  accessCardDeposit Decimal @default(0) @db.Decimal(10, 2)
  adminFee          Decimal @default(0) @db.Decimal(10, 2)
  /// Pro-rata rent charged for an early move-in (if any) — shown on the tenancy agreement
  /// document as its own line item, same as the other move-in charges below, and folded into
  /// totalOutstanding. Set at contract creation, or added to by the Admin "开 Pro-rata 账单"
  /// action on an already-existing contract.
  prorataAmount     Decimal @default(0) @db.Decimal(10, 2)
  totalOutstanding  Decimal @default(0) @db.Decimal(10, 2)

  status ContractStatus @default(DRAFT)

  agentSignature  String?
  agentSignDate   DateTime?
  tenantSignature String?
  tenantSignDate  DateTime?

  commAmount Decimal?  @db.Decimal(10, 2)
  commStatus String?   @default("Pending")
  commPaidAt DateTime?

  createdBy   String
  createdAt   DateTime  @default(now())
  approvedBy  String?
  approvedAt  DateTime?
  autoDeleteAt DateTime?
  pdfLink     String?
  remarks     String?

  nationality   String?
  contactNumber String?
  email         String?
  occupation    String?
  company       String?
  carPlate      String?

  emergencyName         String?
  emergencyContact      String?
  emergencyRelationship String?

  utilDryer    Boolean @default(false)
  utilAircond  Boolean @default(false)
  utilElectric Boolean @default(false)

  icFront String?
  icBack  String?

  /// How many people live in the room under this contract — only used when a unit's shared
  /// electricity / washer-dryer usage is split by headcount instead of by room.
  occupants Int @default(1)

  payments            Payment[]
  commissions         Commission[]
  moveForms           MoveInOutForm[]
  maintenanceRequests MaintenanceRequest[]
  warningLetters      WarningLetter[]
  vouchers            Voucher[]
  utilityExemptions   UtilityExemption[]
  utilityCredits      UtilityCredit[]

  @@index([status])
  @@index([agentId])
  @@index([tenantId])
  @@index([roomId])
}

model Payment {
  id          String      @id @default(cuid())
  paymentCode String      @unique
  contractId  String
  contract    Contract    @relation(fields: [contractId], references: [id])
  roomCode    String
  tenantId    String?
  tenantName  String?
  periodMonth String?
  type        PaymentType
  amountDue   Decimal     @default(0) @db.Decimal(10, 2)
  amountPaid  Decimal     @default(0) @db.Decimal(10, 2)
  dueDate     DateTime?
  paidDate    DateTime?
  status      String      @default("Paid")
  method      String?
  receiptLink String?
  recordedBy  String
  notes       String?
  /// When type=OTHER: Admin's own name for this charge (e.g. "清洁费", "锁匙费") — lets Admin
  /// create ad-hoc bill types on the fly instead of needing a new PaymentType added by a dev.
  customLabel String?

  /// Tenant-upload-then-Admin-approve flow (RENTAL/UTILITIES/AC/DRYER bills): status also takes
  /// "PENDING" (bill issued, awaiting slip), "PENDING_REVIEW" (slip uploaded, awaiting Admin),
  /// "REJECTED" (Admin rejected, tenant must re-upload) alongside the original "Paid".
  reviewedBy       String?
  reviewedAt       DateTime?
  reviewNote       String?
  /// For LATE_FEE rows auto-generated by the cron job: id of the overdue bill this penalty is for.
  relatedPaymentId String?
  /// Set on ELECTRIC / DRYER / AC usage bills issued from 抄表开单 — the monthly run they came from.
  utilityRunId     String?
  utilityRun       UtilityBillRun? @relation(fields: [utilityRunId], references: [id], onDelete: SetNull)

  @@index([contractId])
}

/// A company-issued reward/goodwill voucher handed to a tenant ahead of time, with its own
/// expiry date — distinct from the immediate, already-spent CREDIT ledger entries elsewhere in
/// this schema. Nothing financial happens at issue time (no Payment row, no Expense): the
/// voucher is just a standing offer until the tenant (or Admin on their behalf) redeems it,
/// which is the moment it actually settles a bill and the company's cost is booked. One that's
/// never redeemed before expiryDate simply lapses — nothing was ever spent, so nothing to
/// unwind. status stays "ISSUED" through its own expiry; a voucher past expiryDate is treated
/// as expired on the fly (same convention as Contract._expired) rather than needing a cron to
/// flip it.
model Voucher {
  id          String    @id @default(cuid())
  voucherCode String    @unique
  contractId  String
  contract    Contract  @relation(fields: [contractId], references: [id])
  tenantId    String?
  tenantName  String
  amount      Decimal   @db.Decimal(10, 2)
  reason      String
  imageUrl    String?
  /// Which of the 2 built-in card designs this voucher shows on 我的代金券 when it has no
  /// imageUrl of its own — "blue" | "pink". Picked by Admin at issue time from a live preview,
  /// not a file upload, so issuing a batch of vouchers never depends on Admin having a nice
  /// picture on hand.
  template    String    @default("blue")
  expiryDate  DateTime
  status      String    @default("ISSUED") // ISSUED | REDEEMED | CANCELLED
  issuedBy    String
  issuedAt    DateTime  @default(now())
  redeemedAt  DateTime?

  @@index([contractId])
  @@index([tenantId])
}

model Commission {
  id         String   @id @default(cuid())
  commCode   String   @unique
  agentId    String
  agent      User     @relation(fields: [agentId], references: [id])
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id])
  roomCode   String
  saleAmount Decimal  @db.Decimal(10, 2)
  commRate   Decimal  @db.Decimal(6, 4)
  commAmount Decimal  @db.Decimal(10, 2)
  status     String   @default("Pending")
  approvedBy String?
  paidDate   DateTime?
  notes      String?

  @@index([agentId])
  @@index([contractId])
}

model MoveInOutForm {
  id          String   @id @default(cuid())
  formCode    String   @unique
  type        MoveType
  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id])
  tenantId    String?
  tenant      User?    @relation(fields: [tenantId], references: [id])
  roomCode    String
  moveInDate  DateTime?
  formDate    DateTime?
  photos      Json     @default("{}")
  conditions  Json     @default("{}")
  remarks     Json     @default("{}")
  notes       String?
  submittedAt DateTime?
  locked      Boolean   @default(false)

  @@index([contractId, type])
}

model MaintenanceRequest {
  id          String            @id @default(cuid())
  requestCode String            @unique
  contractId  String
  contract    Contract          @relation(fields: [contractId], references: [id])
  roomCode    String
  tenantId    String?
  tenantName  String?
  title       String
  description String?
  photos      Json              @default("[]")
  status      MaintenanceStatus @default(SUBMITTED)
  assignedTo  String?
  adminNote   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  resolvedAt  DateTime?

  /// In-house staff (WORKER role account) upload their own before/after photos here; for
  /// outsourced contractors there's no login, Admin just uploads the invoice/receipt instead.
  workerType         MaintenanceWorkerType?
  assignedWorkerId   String?
  workerBeforePhotos Json                   @default("[]")
  workerAfterPhotos  Json                   @default("[]")
  invoiceUrl         String?
  cost               Decimal?               @db.Decimal(10, 2)
  costPaidAt         DateTime?

  @@index([contractId])
  @@index([status])
  @@index([assignedWorkerId])
}

/// Recurring/operational running costs for a property (water, electricity, wifi, cleaning,
/// ad-hoc maintenance not tied to a MaintenanceRequest ticket, etc.) — deducted from that
/// property's net profit / landlord payout in the monthly report and rolled into the
/// company-wide cash flow's actual outflow.
model Expense {
  id           String          @id @default(cuid())
  expenseCode  String          @unique
  /// Null = company overhead (not tied to any unit), e.g. office or advertising costs.
  propertyId   String?
  property     Property?       @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  /// Optional: the specific room this cost was spent on.
  roomId       String?
  room         Room?           @relation(fields: [roomId], references: [id])
  category     ExpenseCategory
  customLabel  String?
  amount       Decimal         @db.Decimal(10, 2)
  /// Month this expense belongs to (YYYY-MM) — usually the same as expenseDate's month, but
  /// kept separate so a bill paid slightly late/early can still be booked to the right month.
  periodMonth  String
  expenseDate  DateTime
  notes        String?
  recordedBy   String
  createdAt    DateTime        @default(now())
  /// Set when this expense was booked by approving a staff claim.
  claim        ExpenseClaim?

  @@index([propertyId])
  @@index([periodMonth])
}

/// A staff member (Admin/Worker) asking to be paid back for money they spent. Boss/Admin review
/// it (never their own); approving books a matching Expense so unit reports and the P&L pick it
/// up straight away. Paying the staff member back is a separate step with its transfer date.
model ExpenseClaim {
  id              String          @id @default(cuid())
  claimCode       String          @unique
  submittedById   String
  submittedBy     User            @relation("ClaimSubmitter", fields: [submittedById], references: [id])
  submittedByName String
  /// Null = company overhead (not tied to any unit).
  propertyId      String?
  property        Property?       @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  roomId          String?
  room            Room?           @relation(fields: [roomId], references: [id])
  category        ExpenseCategory
  customLabel     String?
  amount          Decimal         @db.Decimal(10, 2)
  expenseDate     DateTime
  periodMonth     String
  notes           String?
  /// Receipt photos / PDFs (Vercel Blob URLs via /api/blob).
  receipts        String[]        @default([])
  status          ClaimStatus     @default(PENDING)
  reviewedById    String?
  reviewedByName  String?
  reviewedAt      DateTime?
  rejectReason    String?
  /// Expense row booked on approval.
  expenseId       String?         @unique
  expense         Expense?        @relation(fields: [expenseId], references: [id])
  /// Pay-back to the staff member.
  paidAt          DateTime?
  paidRef         String?
  paidSlip        String?
  paidById        String?
  paidByName      String?
  createdAt       DateTime        @default(now())

  @@index([status])
  @@index([submittedById])
  @@index([propertyId])
}

model WarningLetter {
  id          String   @id @default(cuid())
  letterCode  String   @unique
  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id])
  message     String
  sentBy      String
  triggeredBy String
  createdAt   DateTime @default(now())

  @@index([contractId])
}

model Log {
  id          String   @id @default(cuid())
  logCode     String   @unique
  timestamp   DateTime @default(now())
  type        String
  toEmail     String?
  subject     String?
  status      String?
  relatedId   String?
  triggeredBy String?
}

/// Day-to-day unit details for Boss/Admin (one row per Property, created on first save). Kept
/// out of Property itself so existing Property queries never pick up the passwords below.
/// Passwords are only ever sent to the browser through the reveal endpoint, which logs who
/// looked; the tenant-facing WiFi endpoint only returns wifiName/wifiPassword.
model PropertyInfo {
  id                     String    @id @default(cuid())
  propertyId             String    @unique
  property               Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // Unit basics
  unitNo                 String?
  sizeSqft               Int?
  bathrooms              Int?
  parkingBays            Int?
  /// Parking bay numbers as painted in the building, e.g. "B2-118, B2-119".
  parkingLotNos          String?
  airconCount            Int?
  waterHeaterCount       Int?
  furnishing             String?
  /// Unit / floor-plan photos (Vercel Blob URLs via /api/blob).
  photos                 String[]  @default([])

  // Passwords (masked; reveal is logged)
  wifiName               String?
  wifiPassword           String?
  routerLogin            String?
  smartLockPassword      String?
  mailboxNo              String?
  mailboxPassword        String?

  // Management office / building
  mgmtContactName        String?
  mgmtOfficePhone        String?
  guardhousePhone        String?
  visitorApp             String?
  buildingRules          String?

  // Owner lease (owner pays maintenance fee, sinking fund, quit rent, assessment, insurance)
  ownerPhone             String?
  ownerBank              String?
  ownerLeaseStart        DateTime?
  ownerLeaseEnd          DateTime?
  ownerRentDueDay        Int?
  /// Latest month (YYYY-MM) the owner rent was marked as paid — drives the dashboard reminder.
  ownerRentPaidPeriod    String?
  renewalNoticeDays      Int?

  // Equipment
  appliances             String?
  airconLastServiced     DateTime?
  fireExtinguisherExpiry DateTime?

  updatedAt              DateTime  @updatedAt
  updatedBy              String?
}

/// One physical access item: access card, RFID tag, carpark remote, door key, mailbox key.
model AccessCard {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// ACCESS_CARD | RFID | REMOTE | KEY | MAILBOX_KEY | OTHER
  cardType   String
  serialNo   String?
  /// ROOM (held by whoever rents roomId) | OFFICE | OWNER | OTHER
  holder     String   @default("OFFICE")
  roomId     String?
  room       Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  /// IN_USE | SPARE | LOST
  status     String   @default("SPARE")
  deposit    Decimal? @db.Decimal(10, 2)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([propertyId])
}

/// A recurring bill account for a unit (electric, water, sewerage, WiFi, gas…).
model UtilityAccount {
  id            String    @id @default(cuid())
  propertyId    String
  property      Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// ELECTRIC | WATER | SEWERAGE | WIFI | GAS | OTHER
  utilityType   String
  provider      String?
  accountNo     String?
  accountHolder String?
  /// GOVERNMENT | MANAGEMENT | PROVIDER | OWNER — who the bill is paid to.
  payTo         String    @default("PROVIDER")
  /// Fixed monthly amount (e.g. WiFi plan); null = varies month to month.
  fixedAmount   Decimal?  @db.Decimal(10, 2)
  /// Day of month the bill is due (1–31).
  dueDay        Int?
  autoDebit     Boolean   @default(false)
  /// Latest billing month (YYYY-MM) marked as paid — drives the dashboard due-bill reminders.
  lastPaidPeriod String?
  meterNo       String?
  /// Contract end (e.g. WiFi 24-month plan).
  contractEnd   DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([propertyId])
}

/// Who did what, when — one row per successful change made through the API (written by
/// withActivity after the response is sent). userId is a plain string, not a relation, so the
/// history survives users being deleted.
model ActivityLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String?
  userName  String
  role      String?
  /// POST / PUT / PATCH / DELETE
  method    String
  path      String
  /// Module label derived from the path, e.g. "报销", "单位资料·门卡".
  area      String
  /// Main code in the path, e.g. "CT-0012", "PXC", "CL-0003".
  target    String?
  /// The success message shown to the user (passwords masked).
  summary   String

  @@index([createdAt])
  @@index([userId])
}

/// A kWh meter whose usage is billed on to tenants: a unit's electricity meter, the shared
/// washer + dryer meter, or one room's aircon meter. A meter tied to a room bills that room's
/// tenant; a meter with no room is shared by everyone living in the unit that month.
model UtilityMeter {
  id           String         @id @default(cuid())
  propertyId   String
  property     Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// ELECTRIC (电费) | LAUNDRY (洗衣机 + 烘干机) | AC (冷气)
  kind         String
  roomId       String?
  room         Room?          @relation(fields: [roomId], references: [id], onDelete: SetNull)
  label        String?
  meterNo      String?
  /// READING: type the meter's reading and usage = this month − last month.
  /// USAGE: type the kWh used directly (e.g. off the TNB bill).
  inputMode    String         @default("READING")
  /// Reading at the start of startPeriod — the "last reading" for its first bill.
  startReading Decimal?       @db.Decimal(12, 2)
  /// First month (YYYY-MM) this meter is billed, e.g. aircon switching from prepaid top-up to
  /// monthly billing from December. Null (meters added before this existed) = the month it was
  /// registered.
  startPeriod  String?
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  readings     MeterReading[]

  @@index([propertyId])
}

/// One meter's usage for one billing month, as entered on 抄表开单.
model MeterReading {
  id        String          @id @default(cuid())
  meterId   String
  meter     UtilityMeter    @relation(fields: [meterId], references: [id], onDelete: Cascade)
  /// Billing month, YYYY-MM
  period    String
  previous  Decimal?        @db.Decimal(12, 2)
  reading   Decimal?        @db.Decimal(12, 2)
  usage     Decimal         @db.Decimal(12, 2)
  /// RM per kWh used for this bill (kept, so a later rate change doesn't rewrite history)
  rate      Decimal         @db.Decimal(6, 4)
  photoUrl  String?
  runId     String?
  run       UtilityBillRun? @relation(fields: [runId], references: [id], onDelete: Cascade)
  createdBy String
  createdAt DateTime        @default(now())

  @@unique([meterId, period])
}

/// A tenant who doesn't pay one kind of usage charge for a period, with the reason. Their share
/// still counts when a shared meter is split — the company pays it — so nobody else pays more.
model UtilityExemption {
  id         String    @id @default(cuid())
  contractId String
  contract   Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  /// ELECTRIC | LAUNDRY | AC
  kind       String
  startDate  DateTime
  /// Last day exempt; null = until the contract ends
  endDate    DateTime?
  reason     String
  createdBy  String
  createdAt  DateTime  @default(now())

  @@index([contractId])
}

/// One unit's usage bills for one month: the readings, how shared meters were split, what each
/// tenant was billed and what the company covered — kept as issued, even if rates or contracts
/// change later.
model UtilityBillRun {
  id            String         @id @default(cuid())
  runCode       String         @unique
  propertyId    String
  property      Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// Billing month, YYYY-MM
  period        String
  /// ROOM | PEOPLE — how shared meters were split
  splitBy       String
  dueDate       DateTime
  totalAmount   Decimal        @db.Decimal(10, 2)
  billedAmount  Decimal        @db.Decimal(10, 2)
  companyAmount Decimal        @db.Decimal(10, 2)
  /// Paid from tenants' prepaid balance (e.g. aircon top-up left over at the switch to monthly
  /// billing): total = billed + credit + company.
  creditAmount  Decimal        @default(0) @db.Decimal(10, 2)
  details       Json
  createdBy     String
  createdAt     DateTime       @default(now())
  readings      MeterReading[]
  payments      Payment[]
  credits       UtilityCredit[]

  @@unique([propertyId, period])
}

/// A tenancy's prepaid balance for a usage charge, as a ledger: + money already paid in (e.g. what
/// was left on the aircon smart meter when the room moved from top-up to monthly billing, or an
/// Admin correction), − what a month's bills used (runId; undoing that month's bills removes the
/// row and gives the balance back). Balance = sum of amount.
model UtilityCredit {
  id         String          @id @default(cuid())
  contractId String
  contract   Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  /// ELECTRIC | LAUNDRY | AC
  kind       String
  amount     Decimal         @db.Decimal(10, 2)
  note       String
  runId      String?
  run        UtilityBillRun? @relation(fields: [runId], references: [id], onDelete: Cascade)
  createdBy  String
  createdAt  DateTime        @default(now())

  @@index([contractId])
  @@index([runId])
}

/// Small editable settings (e.g. RM per kWh for each usage charge), keyed by name.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

/// 会议记录 — one meeting: when and where, who came, each attendee's own notes (written from
/// their own account), and the issues it raised or closed.
model Meeting {
  id            String            @id @default(cuid())
  meetingCode   String            @unique
  title         String
  startsAt      DateTime
  endsAt        DateTime?
  location      String?
  /// People without an account who came (landlord, contractor…), one name each.
  guests        String[]
  /// OPEN: attendees can still write notes · DONE: record finished, notes locked
  status        String            @default("OPEN")
  createdById   String
  createdByName String
  finishedAt    DateTime?
  finishedBy    String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  attendees     MeetingAttendee[]
  notes         MeetingNote[]
  issues        MeetingIssue[]    @relation("IssueRaisedIn")
  issuesDone    MeetingIssue[]    @relation("IssueDoneIn")

  @@index([startsAt])
}

model MeetingAttendee {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([userId])
}

/// One attendee's notes for a meeting; everyone's together make the meeting's record.
model MeetingNote {
  id        String   @id @default(cuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([meetingId, authorId])
}

/// An issue to sort out: raised in a meeting, handled by someone (谁处理), followed up by someone
/// (谁跟进), open until it's marked done — often at a later meeting.
model MeetingIssue {
  id            String    @id @default(cuid())
  issueCode     String    @unique
  meetingId     String
  meeting       Meeting   @relation("IssueRaisedIn", fields: [meetingId], references: [id], onDelete: Cascade)
  title         String
  detail        String?
  /// Who handles it: an account, or just a name for someone without one.
  ownerId       String?
  owner         User?     @relation("IssueOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerName     String?
  followUpId    String?
  followUp      User?     @relation("IssueFollowUp", fields: [followUpId], references: [id], onDelete: SetNull)
  dueDate       DateTime?
  /// OPEN | DONE
  status        String    @default("OPEN")
  doneAt        DateTime?
  doneBy        String?
  doneNote      String?
  /// The meeting it was reported done in, if any.
  doneMeetingId String?
  doneMeeting   Meeting?  @relation("IssueDoneIn", fields: [doneMeetingId], references: [id], onDelete: SetNull)
  createdById   String
  createdByName String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([meetingId])
  @@index([ownerId])
  @@index([followUpId])
  @@index([status])
}
