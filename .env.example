# Neon Postgres — copy the "pooled connection" string from your Neon project dashboard
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/blissrooms?sslmode=require"
# Neon also gives you a *direct* (unpooled) connection string — Prisma Migrate needs this one
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/blissrooms?sslmode=require"

# Random 32+ char secret used to sign session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"

# Vercel Blob — from your Vercel project's Storage tab after creating a Blob store
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"

# Email — used for verification / password-reset / bill / warning-letter notifications.
# Preferred: Gmail SMTP (works with any recipient, no domain to buy/verify). Generate an
# App Password at myaccount.google.com/security (needs 2-Step Verification turned on first).
GMAIL_USER="you@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Alternative: Resend (free API key from resend.com). Only used if GMAIL_USER/
# GMAIL_APP_PASSWORD aren't set. Note: with the default onboarding@resend.dev sender,
# Resend only actually delivers to the email you signed up to Resend with — sending to
# any other recipient needs a verified custom domain in Resend.
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="Bliss Rooms <noreply@yourdomain.com>"

# Secret that protects the /api/cron/* endpoints from being called by anyone but Vercel Cron
CRON_SECRET="replace-with-another-random-secret"

# Public URL of the deployed app (used in verification / reset emails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
